# ============================================================
# HMIS Backend - Environment Variables
# Copy file này thành .env và điền giá trị thực
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_PORT=8080
APP_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-256bit
JWT_EXPIRATION_MS=86400000

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hmis_db
POSTGRES_USER=hmis_user
POSTGRES_PASSWORD=hmis_secret

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── pgAdmin ───────────────────────────────────────────────────
PGADMIN_EMAIL=admin@hmis.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ── Default Tenant (Seed Data) ────────────────────────────────
DEFAULT_TENANT_NAME=Trạm Y tế Mẫu
DEFAULT_TENANT_CODE=TRAM_YTE_MAU

# ── CORS ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1
